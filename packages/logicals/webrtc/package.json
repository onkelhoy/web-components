{
  "name": "@papit/webrtc",
  "description": "",
  "keywords": [
    "webrtc",
    "transport",
    "peer-2-peer"
  ],
  "version": "0.0.3",
  "scripts": {
    "build": "bash ./bin/build.sh",
    "watch": "bash ./bin/watch.sh",
    "start": "bash ./bin/start.sh",
    "preversion": "bash ./bin/_utils/preversion.sh",
    "postversion": "bash ./bin/_utils/postversion.sh",
    "component": "npm run create --include-workspace-root=true --workspace=$(npm prefix) -- --component --location=$(pwd)",
    "test": "node --test"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/types/index.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/",
    ".config"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/types/index.d.ts"
    },
    "./react": {
      "import": "./lib/react/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "author": "Henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "license": "Papit-1.0",
  "homepage": "https://github.com/onkelhoy/web-components/tree/main/packages/logicals/webrtc",
  "bugs": {
    "url": "https://github.com/onkelhoy/web-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git",
    "directory": "packages/logicals/webrtc"
  },
  "devDependencies": {
    "@papit/translator": "0.0.5",
    "@papit/codeblock": "0.0.5",
    "@types/node": "^22.10.2",
    "esbuild": "^0.17.18",
    "sass": "^1.70.0",
    "typescript": "^5.7.2",
    "chokidar": "^3.6.0",
    "@playwright/test": "^1.45.3",
    "playwright": "^1.45.3"
  }
}
