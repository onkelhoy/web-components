{
  "name": "@papit/page-showcase",
  "version": "0.0.6",
  "keywords": [
    "web-component",
    "typescript",
    "sass"
  ],
  "description": "",
  "scripts": {
    "build:sass": "bash ./bin/_utils/sass.sh",
    "build:react": "bash ./bin/_utils/react.sh",
    "build": "bash ./bin/build.sh",
    "watch": "bash ./bin/watch.sh",
    "start": "bash ./bin/start.sh",
    "preversion": "bash ./bin/_utils/preversion.sh",
    "postversion": "bash ./bin/_utils/postversion.sh",
    "component": "npm run create --include-workspace-root=true --workspace=$(npm prefix) -- --component --location=$(pwd)",
    "test": "npx playwright test -c tests/playwright.config.ts",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/types/index.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/",
    "bin/generate.sh",
    ".config"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/types/index.d.ts"
    },
    "./react": {
      "import": "./lib/react/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "bin": {
    "showcase": "./bin/generate.sh"
  },
  "author": "Henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": true,
  "license": "Papit-1.0",
  "homepage": "https://github.com/onkelhoy/web-components/tree/main/packages/pages/showcase",
  "bugs": {
    "url": "https://github.com/onkelhoy/web-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git",
    "directory": "packages/pages/showcase"
  },
  "dependencies": {
    "@papit/button": "0.0.6",
    "@papit/core": "1.0.2",
    "@papit/router": "0.0.6",
    "@papit/tabs": "0.0.5",
    "@papit/typography": "0.0.6"
  },
  "devDependencies": {
    "@papit/card": "workspace:*",
    "@papit/codeblock": "workspace:*",
    "@papit/translator": "workspace:*",
    "@papit/typography": "workspace:*",
    "@playwright/test": "^1.45.3",
    "@types/node": "^22.10.2",
    "chokidar": "^3.6.0",
    "esbuild": "^0.17.18",
    "sass": "^1.70.0",
    "typescript": "^5.7.2"
  }
}