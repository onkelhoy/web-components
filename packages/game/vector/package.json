{
  "name": "@papit/game-vector",
  "description": "High-performance vector math library for games, WebGL, and real-time simulations.",
  "version": "1.0.0",
  "scripts": {
    "build": "bash ./bin/build.sh",
    "watch": "bash ./bin/watch.sh",
    "start": "bash ./bin/start.sh",
    "publish:manual": "bash ./bin/publish.sh",
    "preversion": "bash ./bin/_utils/preversion.sh",
    "postversion": "bash ./bin/_utils/postversion.sh",
    "component": "npm run create --include-workspace-root=true --workspace=$(npm prefix) -- --component --location=$(pwd)",
    "test": "node --test"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/types/index.d.ts",
  "sideEffects": false,
  "type": "module",
  "files": [
    "asset/",
    "lib/",
    ".config"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/bundle.js"
    }
  },
  "author": "Henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Papit-1.0",
  "homepage": "https://github.com/onkelhoy/web-components/tree/main/packages/game/vector",
  "bugs": {
    "url": "https://github.com/onkelhoy/web-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git",
    "directory": "packages/game/vector"
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "@papit/game-engine": "0.0.5",
    "@papit/game-input-events": "0.0.7",
    "esbuild": "^0.17.18",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "vector",
    "math",
    "linear-algebra",
    "game-dev",
    "graphics",
    "webgl",
    "opengl",
    "2d",
    "3d",
    "typescript"
  ],
  "dependencies": {}
}