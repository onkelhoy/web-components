{
  "name": "@papit/util-cli",
  "description": "",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "node ./bin/build.cjs",
    "build": "npx @papit/build",
    "watch": "tsc -w",
    "start": "bash ./bin/start.sh",
    "publish:manual": "bash ./bin/publish.sh",
    "preversion": "bash ./bin/_utils/preversion.sh",
    "postversion": "bash ./bin/_utils/postversion.sh",
    "component": "npm run create --include-workspace-root=true --workspace=$(npm prefix) -- --component --location=$(pwd)",
    "test": "node --test"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "files": [
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/index.d.ts"
    }
  },
  "homepage": "https://github.com/onkelhoy/web-components/tree/main/packages/runtime/cli/util",
  "bugs": {
    "url": "https://github.com/onkelhoy/web-components/issues"
  },
  "author": "Henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Papit-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git",
    "directory": "packages/runtime/cli/util"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "node",
    "typescript"
  ],
  "papit": {
    "publish": true,
    "type": "node",
    "main": {
      "name": "util",
      "className": "Util"
    },
    "components": {}
  }
}