    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git",
    "directory": "packages/runtime/cli/create"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/cli-util": "0.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.17.18",
