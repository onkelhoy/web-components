    "preversion": "bash ./bin/_utils/preversion.sh",
    "postversion": "bash ./bin/_utils/postversion.sh",
    "component": "npm create @papit -- --component",
    "test": "node --test"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "homepage": "https://github.com/onkelhoy/web-components/tree/main/packages/runtime/cli/create",
