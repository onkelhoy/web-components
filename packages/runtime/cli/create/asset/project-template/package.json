{
  "name": "VARIABLE_NAME",
  "version": "0.0.0",
  "description": "VARIABLE_DESCRIPTION",
  "private": true,
  "scripts": {
    "analyse": "bash ./bin/analyse/run.sh",
    "create": "npm create @papit -- --package",
    "publish": "bash ./bin/publish/run.sh",
    "build": "bash ./bin/build/run.sh",
    "test": "bash ./bin/test/run.sh",
    "server": "npx @papit/server"
  },
  "keywords": [
    "typescript"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20"
  },
  "author": "VARIABLE_USER",
  "license": "VARIABLE_PROJECTLICENSE",
  "workspaces": [
    "packages/**/*",
    "!packages/**/asset/**"
  ],
  "papit": {
    "layers": {
      "packages/atoms": {
        "include": "false",
        "name": "atom"
      },
      "packages/molecules": {
        "include": "false",
        "name": "molecule"
      },
      "packages/organisms": {
        "include": "false",
        "name": "organism"
      },
      "packages/pages": {
        "include": "suffix",
        "name": "page"
      },
      "packages/templates": {
        "include": "suffix",
        "name": "template"
      }
    }
  }
}