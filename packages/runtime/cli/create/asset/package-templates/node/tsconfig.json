{
  "compilerOptions": {
    "target": "es2022",
    "module": "node18",
    "moduleResolution": "node16",
    "noEmitOnError": true,
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    
    "outDir": "lib",
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./",
    "allowJs": true,
    "declarationDir": "lib/types",
    "declaration": true,
    "incremental": true,
    "resolveJsonModule": true,
    "baseUrl": "src",

    "paths": {
      "PLACEHOLDER_FULL_NAME": ["./index"],
    }
  },
  "include": ["src", "tests"]
}