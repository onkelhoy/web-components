{
  "name": "@papit/cli-build",
  "description": "build tool for @papit packages",
  "keywords": [
    "papit",
    "node",
    "typescript",
    "build"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "bash ./bin/build.sh",
    "watch": "bash ./bin/watch.sh",
    "start": "npm run build && node ./lib/bundle.js",
    "preversion": "bash ./bin/_utils/preversion.sh",
    "postversion": "bash ./bin/_utils/postversion.sh",
    "component": "npm run create --include-workspace-root=true --workspace=$(npm prefix) -- --component --location=$(pwd)",
    "test": "npx playwright test -c tests/playwright.config.ts"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/types/index.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/",
    ".config"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/web-components/tree/main/packages/runtime/cli",
  "bugs": {
    "url": "https://github.com/onkelhoy/web-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git",
    "directory": "packages/runtime/cli"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/cli-util": "^0.0.1",
    "@microsoft/api-extractor": "^7.55.2",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "chokidar": "^3.6.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ]
}
