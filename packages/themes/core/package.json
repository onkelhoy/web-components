{
  "name": "@papit/theme-core",
  "version": "0.0.4",
  "keywords": [
    "theme",
    "css"
  ],
  "description": "",
  "scripts": {
    "build": "bash ./bin/build.sh",
    "start": "bash ./bin/start.sh",
    "watch": "bash ./bin/watch.sh",
    "preanalyse": "npm run build",
    "analyse": "npm run analyse --include-workspace-root=true --workspace=$(npm prefix) -- --theme --location=$(pwd)",
    "preversion": "bash ./bin/_utils/preversion.sh",
    "postversion": "bash ./bin/_utils/postversion.sh",
    "test": "npx playwright test -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "type": "module",
  "main": "./style.css",
  "files": [
    "lib/",
    ".config"
  ],
  "author": "Henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "license": "Papit-1.0",
  "homepage": "https://github.com/onkelhoy/web-components/tree/main/packages/themes/core",
  "bugs": {
    "url": "https://github.com/onkelhoy/web-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git",
    "directory": "packages/themes/core"
  },
  "devDependencies": {
    "@papit/card": "workspace:*",
    "@papit/codeblock": "workspace:*",
    "@papit/translator": "workspace:*",
    "@papit/typography": "workspace:*",
    "@playwright/test": "^1.45.3",
    "@types/node": "^22.10.2",
    "playwright": "^1.45.3",
    "sass": "^1.70.0",
    "typescript": "^5.7.2"
  }
}