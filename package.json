{
  "name": "@papit/root",
  "version": "0.0.0",
  "description": "framework/ecosystem",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/onkelhoy/web-components.git"
  },
  "scripts": {
    "analyse": "bash ./bin/analyse/run.sh",
    "create": "bash ./bin/create/run.sh",
    "clean": "bash ./bin/_utils/clean.sh",
    "init": "bash ./bin/_utils/init.sh",
    "publish": "bash ./bin/publish/run.sh",
    "build": "bash ./bin/build/run.sh",
    "test": "bash ./bin/test/run.sh",
    "server": "npx @papit/server"
  },
  "keywords": [
    "typescript"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20"
  },
  "author": "Henry Pap",
  "license": "LicenseRef-Papit-1.0",
  "workspaces": [
    "packages/**/*",
    "!packages/**/asset/**"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "^7.55.2",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  },
  "papit": {
    "layers": {
      "packages/runtime": {
        "include": "false",
        "name": "runtime"
      },
      "packages/runtime/cli": {
        "include": "prefix",
        "name": "cli"
      },
      "packages/temp": {
        "include": false,
        "name": "temp"
      }
    }
  }
}